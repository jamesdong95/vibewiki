generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id         String   @id @default(cuid())
  userId     String
  totalCents Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}
